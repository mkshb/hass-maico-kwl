          "scan_interval": "Scan interval (seconds)",
          "accessories": "Fitted accessories",
          "room_temp_source_entity": "Room temperature source entity",
          "humidity_source_entity": "Humidity source entity",
          "air_quality_source_entity": "Air quality source entity"
        },
        "data_description": {
          "scan_interval": "How often the values are read from the unit. 30 seconds is enough for most uses.",
          "accessories": "Preselected from what the integration detected on the unit. Entities of accessories that are not selected are removed.",
          "room_temp_source_entity": "Temperature sensor whose value is sent to the unit as room temperature. Only used by the unit if the room temperature source is set to \"Bus\".",
          "humidity_source_entity": "Humidity sensor whose value is sent to the unit. Only used if the unit is configured to take the humidity over the bus.",
          "air_quality_source_entity": "Air quality sensor (ppm) whose value is sent to the unit. Only used if the unit is configured to take the air quality over the bus."
        }
      }
    }
