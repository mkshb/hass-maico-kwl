{
  "config": {
    "step": {
      "user": {
        "title": "Maico KWL",
        "description": "Connect to your Maico ventilation unit over Modbus TCP. The integration will probe the device and create entities only for the registers it actually implements.",
        "data": {
          "host": "Host",
          "port": "Port",
          "slave": "Modbus address",
          "scan_interval": "Scan interval (seconds)"
        },
        "data_description": {
          "host": "IP address or hostname of the unit or of the Modbus TCP gateway in front of it.",
          "port": "Modbus TCP port, usually 502.",
          "slave": "Modbus address (unit ID) of the ventilation unit. Maico units use 10 by default.",
          "scan_interval": "How often the values are read from the unit. 30 seconds is enough for most uses."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Maico KWL",
        "description": "Change how the unit is reached, e.g. after the gateway got a new IP address. The connection is tested before the change is saved.",
        "data": {
          "host": "Host",
          "port": "Port",
          "slave": "Modbus address"
        },
        "data_description": {
          "host": "IP address or hostname of the unit or of the Modbus TCP gateway in front of it.",
          "port": "Modbus TCP port, usually 502.",
          "slave": "Modbus address (unit ID) of the ventilation unit. Maico units use 10 by default."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the device."
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "reconfigure_successful": "The connection settings were updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Maico KWL options",
        "description": "Optionally choose source entities whose values are sent to the unit cyclically (the matching source, e.g. room temperature, must be set to \"Bus\"). Leave empty to control the value manually.",
        "data": {
          "scan_interval": "Scan interval (seconds)",
          "room_temp_source_entity": "Room temperature source entity",
          "humidity_source_entity": "Humidity source entity",
          "air_quality_source_entity": "Air quality source entity"
        },
        "data_description": {
          "scan_interval": "How often the values are read from the unit. 30 seconds is enough for most uses.",
          "room_temp_source_entity": "Temperature sensor whose value is sent to the unit as room temperature. Only used by the unit if the room temperature source is set to \"Bus\".",
          "humidity_source_entity": "Humidity sensor whose value is sent to the unit. Only used if the unit is configured to take the humidity over the bus.",
          "air_quality_source_entity": "Air quality sensor (ppm) whose value is sent to the unit. Only used if the unit is configured to take the air quality over the bus."
        }
      }
    }
  },
