  "issues": {
    "fault_active": {
      "title": "{name} reports a fault",
      "description": "The ventilation unit reports an active fault: {faults}.\n\nCheck the unit and its control panel. Once the cause is fixed, the fault can be cleared with the *Reset errors* button. This message disappears as soon as the unit no longer reports the fault."
    },
    "filter_due_device": {
      "title": "Device filter of {name} is due",
      "description": "The remaining time of the device filter has run out.\n\nReplace or clean the filter, then press the *Reset device filter* button. This message disappears once the unit counts the filter time again."
    },
    "filter_due_outdoor": {
      "title": "Outdoor filter of {name} is due",
      "description": "The remaining time of the outdoor filter has run out.\n\nReplace or clean the filter, then press the *Reset outdoor filter* button. This message disappears once the unit counts the filter time again."
    },
    "filter_due_room": {
      "title": "Room filter of {name} is due",
      "description": "The remaining time of the room filter has run out.\n\nReplace or clean the filter, then press the *Reset room filter* button. This message disappears once the unit counts the filter time again."
    },
    "clock_drift": {
      "title": "Clock of {name} is off",
      "description": "The clock of the ventilation unit is off by about {minutes} minutes, so its time programs run at the wrong time.\n\nPress the *Sync clock with Home Assistant* button to set it to the time of Home Assistant."
    },
    "bus_source_missing": {
      "title": "Bus source of {name} is missing",
      "description": "{entity} is set as the source of a bus input under **Configure**, but it no longer exists. The unit gets no new value for this input.\n\nChoose another source under **Configure** on the integration, or leave it empty to set the value manually. This message disappears once the source exists again or is changed."
    },
    "bus_source_no_data": {
      "title": "Bus source of {name} sends no data",
      "description": "{entity} is set as the source of a bus input under **Configure**, but has given no value that can be sent for more than 30 minutes ({reason}). The unit gets no new value for this input.\n\nCheck the source: it needs a number within the range of the input, in °C, °F or K for the room temperature, % for the humidity and ppm or ppb for the air quality. This message disappears with the next value that is sent."
    },
    "bus_value_not_delivered": {
      "title": "{name} gets no bus value",
      "description": "The value of bus input {register} (707 room temperature, 763 humidity, 764 air quality) could not be written for 10 minutes: {error}.\n\nThe unit only keeps a bus value for 10 minutes and then uses its internal sensor again. The integration keeps trying every minute. Check the connection to the unit. This message disappears with the next successful write."
    }
  },
