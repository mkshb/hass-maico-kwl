  "config": {
    "step": {
      "user": {
        "title": "Maico KWL",
        "description": "Connect to your Maico ventilation unit over Modbus TCP. The integration will probe the device and create entities only for the registers it actually implements.",
        "data": {
          "host": "Host",
          "port": "Port",
          "slave": "Modbus address",
          "scan_interval": "Scan interval (seconds)"
        },
        "data_description": {
          "host": "IP address or hostname of the unit or of the Modbus TCP gateway in front of it.",
          "port": "Modbus TCP port, usually 502.",
          "slave": "Modbus address (unit ID) of the ventilation unit. Maico units use 10 by default.",
          "scan_interval": "How often the values are read from the unit. 30 seconds is enough for most uses."
        }
      },
      "reconfigure": {
        "title": "Reconfigure Maico KWL",
        "description": "Change how the unit is reached, e.g. after the gateway got a new IP address. The connection is tested before the change is saved.",
        "data": {
          "host": "Host",
          "port": "Port",
          "slave": "Modbus address"
        },
        "data_description": {
          "host": "IP address or hostname of the unit or of the Modbus TCP gateway in front of it.",
          "port": "Modbus TCP port, usually 502.",
          "slave": "Modbus address (unit ID) of the ventilation unit. Maico units use 10 by default."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the device."
