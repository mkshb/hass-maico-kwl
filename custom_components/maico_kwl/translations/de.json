    "step": {
      "user": {
        "title": "Maico KWL",
        "description": "Verbinde dich per Modbus TCP mit deinem Maico-Lüftungsgerät. Die Integration tastet das Gerät ab und legt nur Entitäten für tatsächlich vorhandene Register an.",
