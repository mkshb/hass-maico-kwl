  "options": {
    "step": {
      "init": {
        "title": "Maico KWL options",
        "description": "Choose the accessories fitted to your unit and, optionally, source entities whose values are sent to the unit cyclically (the matching source, e.g. room temperature, must be set to \"Bus\"). Leave a source empty to control the value manually.",
