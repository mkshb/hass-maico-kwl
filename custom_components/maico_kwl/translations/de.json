          "host": "Host",
          "port": "Port",
          "slave": "Modbus-Adresse",
          "scan_interval": "Abfrageintervall (Sekunden)"
        },
        "data_description": {
          "host": "IP-Adresse oder Hostname des Geräts bzw. des vorgeschalteten Modbus-TCP-Gateways.",
          "port": "Modbus-TCP-Port, meist 502.",
          "slave": "Modbus-Adresse (Unit-ID) des Lüftungsgeräts. Maico-Geräte verwenden standardmäßig 10.",
          "scan_interval": "Wie oft die Werte vom Gerät gelesen werden. 30 Sekunden reichen für die meisten Anwendungen."
        }
      },
      "reconfigure": {
        "title": "Maico KWL neu konfigurieren",
